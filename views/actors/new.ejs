<!DOCTYPE html>
<html>
<head><title>Nuevo Actor</title></head>
<body>
  <h1>Nuevo Actor</h1>
  <form action="/actors" method="POST">
    <input name="name" placeholder="Nombre" required><br>
    <input name="nationality" placeholder="Nacionalidad"><br>
    <input name="birthYear" placeholder="Año de nacimiento" type="number"><br>
    <button type="submit">Crear</button>
  </form>
  <a href="/actors">Cancelar</a>
</body>
</html>